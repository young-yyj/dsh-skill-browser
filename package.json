{
  "name": "dsh-skill-browser",
  "version": "0.1.6",
  "private": true,
  "description": "Read-only skill browser for DeepSeek Harness",
  "license": "MIT",
  "author": "young-yyj",
  "homepage": "https://github.com/young-yyj/dsh-skill-browser#readme",
  "bugs": {
    "url": "https://github.com/young-yyj/dsh-skill-browser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/young-yyj/dsh-skill-browser.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "skills",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": "0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "types": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/build.mjs",
    "build": "npm run clean && npm run types && npm run bundle",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.1",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.1"
  }
}
